cabal-version:      3.0
name:               sql-schema
version:            0.4.3
synopsis:           A GHC plugin to check SQL schema consistency between Haskell code and DB schema
license:            MIT
license-file:       LICENSE
author:             juspay
maintainer:         saurabh.saini@juspay.in
description:
    A GHC plugin that extracts the SQL schema implied by Beam table definitions
    into one YAML fragment per module, and a companion executable,
    sql-schema-merge, that combines the fragments (and any pre-merged
    contracts) into a single schema contract for comparison with a live
    database.
category:           Database
build-type:         Simple
tested-with:        GHC == 9.2.8, GHC == 9.8.4
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        SqlSchema.Plugin
      , SqlSchema.Types
      , SqlSchema.Merge
      , SqlSchema.MergeCli
      , SqlSchema.Extract
    other-modules:
        Paths_sql_schema
    autogen-modules:
        Paths_sql_schema
    build-depends:
        base ^>=4.16 || ^>=4.19
      , bytestring
      , containers
      , directory
      , filepath
      , ghc ^>=9.2 || ^>=9.8
      , text
        -- Bounded to the versions tested (9.2.8's and 9.8.4's): they decode and write the contract.
      , aeson >=2.0.3 && <2.3
      , yaml >=0.11.11 && <0.12
      , libyaml >=0.1.2 && <0.2
    hs-source-dirs:   src
    default-language: Haskell2010

executable sql-schema-merge
    import:           warnings
    main-is:          Merge.hs
    hs-source-dirs:   app
    build-depends:
        base ^>=4.16 || ^>=4.19
      , sql-schema
    default-language: Haskell2010

test-suite sql-schema-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        TestUtil
      , MergeTests
      , CliTests
      , ContractTests
      , ParseFixture
      , ExtractTests
      , StageTests
    build-depends:
        base ^>=4.16 || ^>=4.19
      , bytestring
      , directory
      , filepath
      , ghc
      , sql-schema
      , temporary
      , yaml
