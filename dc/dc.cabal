cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'dc' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               dc

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-2-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Chaitanya Nair

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         chaitanya.nair@juspay.in

-- A copyright notice.
-- copyright:
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    -- Import common warning flags.
    import:           warnings

    -- Modules exported by the library.
    exposed-modules:  DC.DefaultCheck
    default-extensions: OverloadedStrings
    other-modules: DC.Types, DC.Constants

    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base, directory, bytestring, aeson, extra, aeson-pretty, unordered-containers, uniplate, ghc, references, yaml


    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: Haskell2010

-- dc-test: a valid, parseable domainConfig.yaml is present. checkIntegrity
-- must take the Right branch and compile cleanly -- this stanza building and
-- passing at all is the test.
test-suite dc-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ValidConfigMain.hs
    ghc-options: -fplugin=DC.DefaultCheck -fplugin-opt=DC.DefaultCheck:{"domainConfigFile":".juspay/valid/domainConfig.yaml","failOnFileNotFound":true}
    build-depends:
        base,
        dc

-- dc-test-missing-config-bypass: no config file at the given path, and
-- failOnFileNotFound=false. checkIntegrity must bypass silently (the
-- pre-existing, still-supported opt-out) -- this stanza building and passing
-- at all is the test.
test-suite dc-test-missing-config-bypass
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          MissingConfigBypassMain.hs
    ghc-options: -fplugin=DC.DefaultCheck -fplugin-opt=DC.DefaultCheck:{"domainConfigFile":".juspay/nonexistent/domainConfig.yaml","failOnFileNotFound":false}
    build-depends:
        base,
        dc

-- dc-test-invalid-yaml: the config file exists but is malformed YAML.
-- checkIntegrity must now raise a compile error unconditionally instead of
-- bypassing, so this stanza is EXPECTED TO FAIL TO BUILD -- that failure is
-- the test passing. See flake.nix (dc.check = false).
test-suite dc-test-invalid-yaml
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          InvalidYamlMain.hs
    ghc-options: -fplugin=DC.DefaultCheck -fplugin-opt=DC.DefaultCheck:{"domainConfigFile":".juspay/invalid/domainConfig.yaml"}
    build-depends:
        base,
        dc

-- dc-test-missing-config-strict: no config file at the given path, and
-- failOnFileNotFound left at its default (true). checkIntegrity must raise a
-- compile error instead of bypassing, so this stanza is EXPECTED TO FAIL TO
-- BUILD -- that failure is the test passing. See flake.nix (dc.check = false).
test-suite dc-test-missing-config-strict
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          MissingConfigStrictMain.hs
    ghc-options: -fplugin=DC.DefaultCheck -fplugin-opt=DC.DefaultCheck:{"domainConfigFile":".juspay/nonexistent/domainConfig.yaml"}
    build-depends:
        base,
        dc
